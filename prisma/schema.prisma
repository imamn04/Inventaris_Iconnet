generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  name     String

  @@map("users")
}

model Inventory {
  id            String    @id
  no            Int?
  name          String?
  merk          String?
  sn            String?
  lokasi        String?
  kondisiBefore String?   @map("kondisi_before")
  checklist     String?
  kondisiAfter  String?   @map("kondisi_after")
  catatan       String?
  date          DateTime? @db.Date
  qrCode        String?   @map("qr_code")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  tanggalMasuk  DateTime? @map("tanggal_masuk") @db.Date
  snConverter   String?   @map("sn_converter")
  cubicleId     String?   @map("cubicle_id")

  @@map("inventory")
}

model CubiclePosition {
  cubicleId String  @id @map("cubicle_id")
  x         Int?    @default(0)
  y         Int?    @default(0)
  type      String? @default("cubicle") @db.VarChar(20)
  text      String?

  @@map("cubicle_positions")
}

model Handover {
  id                 Int       @id @default(autoincrement())
  jenis              String
  itemId             String    @map("item_id")
  itemName           String?   @map("item_name")
  itemMerk           String?   @map("item_merk")
  itemSn             String?   @map("item_sn")
  pihakPenyerah      String?   @map("pihak_penyerah")
  pihakPenerima      String?   @map("pihak_penerima")
  tanggalSerahTerima DateTime? @map("tanggal_serah_terima") @db.Date
  kondisiBefore      String?   @map("kondisi_before")
  kondisiAfter       String?   @map("kondisi_after")
  lokasiBaru         String?   @map("lokasi_baru")
  catatan            String?
  timestamp          DateTime? @default(now()) @db.Timestamp(6)
  itemSnConverter    String?   @map("item_sn_converter")
  noBeritaAcara      String?   @map("no_berita_acara") @db.VarChar(100)
  signature          String?

  @@map("handover")
}

model SerahTerima {
  id                 Int       @id @default(autoincrement())
  kodeTransaksi      String?   @unique @map("kode_transaksi")
  itemId             String?   @map("item_id")
  itemName           String?   @map("item_name")
  itemMerk           String?   @map("item_merk")
  itemSn             String?   @map("item_sn")
  tanggal            DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  pemberi            String
  departemenPemberi  String?   @map("departemen_pemberi")
  penerima           String
  departemenPenerima String?   @map("departemen_penerima")
  kondisiSaatSerah   String?   @map("kondisi_saat_serah")
  keterangan         String?
  status             String?   @default("Pending")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  noBeritaAcara      String?   @map("no_berita_acara") @db.VarChar(100)

  @@map("serah_terima")
}

model History {
  id         Int       @id @default(autoincrement())
  action     String
  itemId     String?   @map("item_id")
  itemName   String?   @map("item_name")
  itemMerk   String?   @map("item_merk")
  itemSn     String?   @map("item_sn")
  itemLokasi String?   @map("item_lokasi")
  details    String?
  timestamp  DateTime? @default(now()) @db.Timestamp(6)

  @@map("history")
}

model MapLayout {
  blockName String @id @map("block_name")
  x         Int?   @default(0)
  y         Int?   @default(0)

  @@map("map_layout")
}
