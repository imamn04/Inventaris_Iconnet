# Server Configuration
PORT=3000
NODE_ENV=production

# PostgreSQL Database Connection (Prisma ORM)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public
DATABASE_URL="postgresql://your_db_user:your_secure_password_here@localhost:5432/inventaris_iconnet?schema=public"

# Security & CORS Configuration
CORS_ORIGIN=*
JWT_SECRET=your_jwt_secret_key_here_min_32_characters_random
BCRYPT_SALT_ROUNDS=10

# Docker Compose Environment Variables (Server Deployment)
POSTGRES_DB=inventaris_iconnet
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password_here
